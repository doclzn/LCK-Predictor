# Bancos de dados e backups - dados derivados do Oracle's Elixir.
# O banco principal E versionado, mas comprimido (~14 MB em vez de 57 MB):
# veja scripts/db_snapshot.py. O .sqlite cru fica de fora.
LCK_Predictor_V28_AUTO_DRAFT/data/*.sqlite
LCK_Predictor_V28_AUTO_DRAFT/data/*.sqlite-shm
LCK_Predictor_V28_AUTO_DRAFT/data/*.sqlite-wal
LCK_Predictor_V28_AUTO_DRAFT/data/*.backup-*
LCK_Predictor_V28_AUTO_DRAFT/data/*.pre-restore-*

# excecao: o snapshot comprimido do banco principal
!LCK_Predictor_V28_AUTO_DRAFT/data/lck_data_v1.sqlite.gz

# Runtime Python portatil com site-packages (346 MB)
LCK_Predictor_V28_AUTO_DRAFT/runtime/

# CSVs do Oracle's Elixir (redistribuicao nao autorizada)
*.csv

# Capturas e artefatos locais
LCK_Predictor_V28_AUTO_DRAFT/data/live_tests/
LCK_Predictor_V28_AUTO_DRAFT/data/riot_capture/
LCK_Predictor_V28_AUTO_DRAFT/_gol_*.html

__pycache__/
*.pyc

# Backups locais de governanca e banco (nao versionar)
LCK_Predictor_V28_AUTO_DRAFT/governance.backup-*/
LCK_Predictor_V28_AUTO_DRAFT/governance/*.backup-*
